{
  "pages": [
    {
      "path": "pages/feed/feed",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundColor": "@pageBg"
      }
    },
    {
      "path": "pages/publish/publish",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/mine/mine",
      "style": { "navigationBarTitleText": "我的" }
    },
    {
      "path": "pages/login/login",
      "style": { "navigationStyle": "custom" }
    },
    {
      "path": "pages/detail/detail",
      "style": { "navigationStyle": "custom", "backgroundColor": "#111111" }
    },
    {
      "path": "pages/user/user",
      "style": { "navigationBarTitleText": "用户主页" }
    },
    {
      "path": "pages/search/search",
      "style": { "navigationBarTitleText": "搜索" }
    },
    {
      "path": "pages/guide/guide",
      "style": { "navigationBarTitleText": "如何成为点评人" }
    },
    {
      "path": "pages/notify/notify",
      "style": { "navigationBarTitleText": "消息" }
    },
    {
      "path": "pages/following/following",
      "style": { "navigationBarTitleText": "我关注的" }
    },
    {
      "path": "pages/chat/chat",
      "style": { "navigationBarTitleText": "私信" }
    },
    {
      "path": "pages/settings/settings",
      "style": { "navigationBarTitleText": "设置" }
    },
    {
      "path": "pages/collection/collection",
      "style": { "navigationBarTitleText": "合集" }
    },
    {
      "path": "pages/rank/rank",
      "style": { "navigationBarTitleText": "口碑榜" }
    },
    {
      "path": "pages/blocks/blocks",
      "style": { "navigationBarTitleText": "黑名单" }
    },
    {
      "path": "pages/folders/folders",
      "style": { "navigationBarTitleText": "收藏夹" }
    },
    {
      "path": "pages/browse/browse",
      "style": { "navigationBarTitleText": "浏览记录", "enablePullDownRefresh": true }
    },
    {
      "path": "pages/draftbox/draftbox",
      "style": { "navigationBarTitleText": "草稿箱" }
    }
  ],
  "subPackages": [
    {
      "root": "pagesAdmin",
      "pages": [
        { "path": "audit/audit", "style": { "navigationBarTitleText": "内容管理" } },
        { "path": "users/users", "style": { "navigationBarTitleText": "用户管理" } },
        { "path": "announce/announce", "style": { "navigationBarTitleText": "发布公告" } }
      ]
    }
  ],
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/feed/feed",
        "text": "首页",
        "iconPath": "@tabHome",
        "selectedIconPath": "@tabHomeOn"
      },
      {
        "pagePath": "pages/publish/publish",
        "text": "发布",
        "iconPath": "@tabPlus",
        "selectedIconPath": "@tabPlusOn"
      },
      {
        "pagePath": "pages/notify/notify",
        "text": "消息",
        "iconPath": "@tabMsg",
        "selectedIconPath": "@tabMsgOn"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "@tabMy",
        "selectedIconPath": "@tabMyOn"
      }
    ]
  },
  "globalStyle": {
    "darkmode": true,
    "themeLocation": "theme.json",
    "navigationBarTextStyle": "@navTxt",
    "navigationBarTitleText": "本地点评",
    "navigationBarBackgroundColor": "@navBg",
    "backgroundColor": "@pageBg"
  }
}
